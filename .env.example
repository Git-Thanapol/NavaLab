# Copy this file to .env and fill in real values before `docker compose up -d`.
# Never commit the real .env file.

# --- Domain & TLS (Caddy) ---
# Must point at this server's public IP. Caddy issues a Let's Encrypt cert
# for it automatically the first time it starts.
SITE_DOMAIN=navalab.org

# --- builder: which repo to clone/pull and build ---
GIT_REPO_URL=https://github.com/Git-Thanapol/NavaLab.git
GIT_BRANCH=main
# GitHub personal access token with repo read access (Settings > Developer
# settings > Fine-grained tokens). Used only to clone/pull, never written to
# the image.
GITHUB_TOKEN=

# --- webhook <-> builder internal auth ---
# Any long random string; only used between containers on the internal
# Docker network. Generate with: openssl rand -hex 32
BUILD_AGENT_SECRET=

# --- GitHub webhook (repo Settings > Webhooks) ---
# Payload URL:  https://$SITE_DOMAIN/hooks/deploy
# Content type: application/json
# Secret:       same value as WEBHOOK_SECRET below
WEBHOOK_SECRET=

# --- CMS GitHub OAuth App (github.com/settings/developers) ---
# Homepage URL:     https://$SITE_DOMAIN
# Callback URL:     https://$SITE_DOMAIN/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://navalab.org/oauth/callback

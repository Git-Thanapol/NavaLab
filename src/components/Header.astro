---
import { Image } from 'astro:assets';
import fullLogo from '../assets/brand/full-logo.png';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** pathname with the /en prefix stripped, e.g. "/" or "/team/jane-doe" */
  cleanPath: string;
}

const { lang, cleanPath } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: '/', label: t('nav.home') },
  { href: '/mission', label: t('nav.mission') },
  { href: '/#team', label: t('nav.team') },
  { href: '/projects', label: t('nav.projects') },
  { href: '/news', label: t('nav.news') },
  { href: '/contact', label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="container-page flex h-20 items-center justify-between py-4">
    <a href={localizePath('/', lang)} class="shrink-0">
      <Image src={fullLogo} alt="NavaLab-TH — Maritime Specialists Community" class="h-11 w-auto sm:h-12" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={localizePath(item.href, lang)}
            class="text-sm font-medium text-navy-500 transition-colors hover:text-navy-900"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <LanguageSwitcher lang={lang} path={cleanPath} />
      <button
        id="nav-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center border border-line md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Menu</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line px-6 py-4 md:hidden" aria-label="Mobile">
    <ul class="flex flex-col gap-3">
      {
        navItems.map((item) => (
          <li>
            <a
              href={localizePath(item.href, lang)}
              class="block py-1 text-sm font-medium text-navy-700"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>

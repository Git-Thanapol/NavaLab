---
import { useTranslations, localizePath, type Lang } from '../../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  prev?: CollectionEntry<'members'>;
  next?: CollectionEntry<'members'>;
}

const { lang, prev, next } = Astro.props;
const t = useTranslations(lang);
---

<nav class="border-t border-line" aria-label="Member pagination">
  <div class="container-page grid grid-cols-2 divide-x divide-line">
    <a
      href={prev ? localizePath(`/team/${prev.id}`, lang) : undefined}
      class:list={['py-8 pr-6', prev ? 'group' : 'pointer-events-none opacity-30']}
      aria-disabled={!prev}
    >
      <p class="text-xs font-medium uppercase tracking-wide text-navy-300">&larr; {t('profile.prev')}</p>
      {prev && <p class="mt-1 font-display text-lg font-bold text-navy-900 group-hover:text-accent">{prev.data.name[lang]}</p>}
    </a>
    <a
      href={next ? localizePath(`/team/${next.id}`, lang) : undefined}
      class:list={['py-8 pl-6 text-right', next ? 'group' : 'pointer-events-none opacity-30']}
      aria-disabled={!next}
    >
      <p class="text-xs font-medium uppercase tracking-wide text-navy-300">{t('profile.next')} &rarr;</p>
      {next && <p class="mt-1 font-display text-lg font-bold text-navy-900 group-hover:text-accent">{next.data.name[lang]}</p>}
    </a>
  </div>
</nav>

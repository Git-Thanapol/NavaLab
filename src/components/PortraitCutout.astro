---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: ImageMetadata;
  alt: string;
  class?: string;
}

const { photo, alt, class: className = '' } = Astro.props;

// Navy -> teal gradient across the cluster (brand navy-700 to accent).
const hexColors = ['#1A2338', '#17394B', '#14505F', '#116673', '#0E7C86'];

// Hexagon centers sweep along a rainbow-style arc — bowed, not a straight
// diagonal — from large/navy at the bottom-left up to small/teal at the
// top-right. Positions are solved (not eyeballed) along the curve so the
// edge-to-edge gap between every pair is ~14 units despite the shrinking
// radius — equal spacing, not equal center distance.
const hexCenters = [
  { cx: 40, cy: 230, r: 52 },
  { cx: 66, cy: 134, r: 47 },
  { cx: 124, cy: 65, r: 42 },
  { cx: 200, cy: 35, r: 36 },
  { cx: 270, cy: 30, r: 29 },
];

function hexPoints(cx: number, cy: number, r: number) {
  const dx = r * 0.866;
  const dy = r * 0.5;
  return [
    [cx, cy - r],
    [cx + dx, cy - dy],
    [cx + dx, cy + dy],
    [cx, cy + r],
    [cx - dx, cy + dy],
    [cx - dx, cy - dy],
  ]
    .map(([x, y]) => `${x},${y}`)
    .join(' ');
}
---

<div class:list={['relative aspect-square w-full', className]}>
  <svg
    viewBox="0 0 300 260"
    aria-hidden="true"
    class="absolute -left-[6%] -top-[12%] h-[105%] w-[105%]"
  >
    {hexCenters.map((c, i) => <polygon points={hexPoints(c.cx, c.cy, c.r)} fill={hexColors[i]} />)}
  </svg>
  <Image
    src={photo}
    alt={alt}
    widths={[320, 480, 640, 960]}
    sizes="(min-width: 1024px) 420px, 70vw"
    class="absolute left-1/2 top-[46%] h-[92%] w-[92%] -translate-x-1/2 -translate-y-1/2 rounded-full object-contain object-top"
  />
</div>

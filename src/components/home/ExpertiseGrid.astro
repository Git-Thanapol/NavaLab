---
import { useTranslations, type Lang } from '../../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  site: CollectionEntry<'site'>;
}

const { lang, site } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-b border-line py-24">
  <div class="container-page">
    <p class="eyebrow mb-4">{t('expertise.eyebrow')}</p>
    <h2 class="max-w-xl text-3xl font-bold text-navy-900">{t('expertise.heading')}</h2>

    <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.data.expertiseAreas.map((area, i) => (
          <div class="border-t border-line pt-6">
            <span class="text-xs font-medium text-navy-300">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-display text-xl font-bold text-navy-900">{area.title[lang]}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{area.description[lang]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

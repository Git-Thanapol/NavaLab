---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  item: CollectionEntry<'news'>;
}

const { lang, item } = Astro.props;
const { data } = item;

// Split on fenced code blocks first so blank lines *inside* a code block
// don't get mistaken for a paragraph break by the plain-text splitter below.
type Block = { type: 'code' | 'text'; content: string };
const blocks: Block[] = [];
const fenceRe = /```[^\n]*\n([\s\S]*?)\n?```/g;
let lastIndex = 0;
let match: RegExpExecArray | null;
while ((match = fenceRe.exec(data.body[lang]))) {
  const before = data.body[lang].slice(lastIndex, match.index);
  blocks.push(...before.split(/\n{2,}/).filter(Boolean).map((content) => ({ type: 'text' as const, content })));
  blocks.push({ type: 'code' as const, content: match[1] });
  lastIndex = fenceRe.lastIndex;
}
const rest = data.body[lang].slice(lastIndex);
blocks.push(...rest.split(/\n{2,}/).filter(Boolean).map((content) => ({ type: 'text' as const, content })));

const dateFormatter = new Intl.DateTimeFormat(lang === 'th' ? 'th-TH' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const ogImage = data.cover ? await getImage({ src: data.cover, width: 1200, height: 630 }) : undefined;
---

<BaseLayout
  lang={lang}
  cleanPath={`/news/${item.id}`}
  title={data.title[lang]}
  description={data.excerpt[lang]}
  image={ogImage?.src}
>
  <article class="py-20">
    <div class="container-page max-w-2xl">
      <span class="text-sm text-navy-300">{dateFormatter.format(data.date)}</span>
      <h1 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">{data.title[lang]}</h1>

      {
        data.cover && (
          <div class="mt-10 aspect-[16/9] overflow-hidden bg-navy-700">
            <Image src={data.cover} alt={data.title[lang]} width={1200} height={675} class="h-full w-full object-cover" />
          </div>
        )
      }

      <div class="mt-10 space-y-5 text-base leading-relaxed text-navy-700">
        {
          blocks.map((block) =>
            block.type === 'code' ? (
              <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-accent-100"><code class="font-mono whitespace-pre">{block.content}</code></pre>
            ) : (
              <p>{block.content}</p>
            )
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

---
import { useTranslations, type Lang } from '../../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'members'>;
  lang: Lang;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);
const { current, completed } = member.data.research;

if (current.length === 0 && completed.length === 0) return null;
---

<section class="border-b border-line bg-mist py-16">
  <div class="container-page grid gap-12 md:grid-cols-2">
    {
      current.length > 0 && (
        <div>
          <p class="eyebrow mb-6">{t('profile.researchCurrent')}</p>
          <ul class="space-y-6">
            {current.map((item) => (
              <li class="border-t border-line pt-4">
                <h3 class="font-display text-lg font-bold text-navy-900">{item.title[lang]}</h3>
                <p class="mt-1 text-sm leading-relaxed text-navy-500">{item.summary[lang]}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      completed.length > 0 && (
        <div>
          <p class="eyebrow mb-6">{t('profile.researchCompleted')}</p>
          <ul class="space-y-6">
            {completed.map((item) => (
              <li class="border-t border-line pt-4">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-display text-lg font-bold text-navy-900">{item.title[lang]}</h3>
                  <span class="shrink-0 text-sm text-navy-300">{item.year}</span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-navy-500">{item.summary[lang]}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

---
import PortraitCutout from '../PortraitCutout.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'members'>;
  lang: Lang;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);
const { data } = member;
---

<section class="overflow-hidden border-b border-line bg-mist">
  <div class="container-page grid gap-12 py-20 md:grid-cols-[1.05fr_0.95fr] md:items-center md:py-28">
    <div class="animate-fade-up">
      <p class="eyebrow mb-6">{t('profile.eyebrow')}</p>
      <h1 class="text-4xl font-bold leading-tight text-navy-900 sm:text-5xl">{data.name[lang]}</h1>
      <p class="mt-3 text-lg text-navy-500">{data.role[lang]}</p>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-navy-500">{data.bio[lang]}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          data.links.email && (
            <a
              href={`mailto:${data.links.email}`}
              class="border border-navy-900 px-6 py-2.5 text-sm font-medium text-navy-900 transition-colors hover:bg-navy-900 hover:text-paper"
            >
              {t('profile.contact')}
            </a>
          )
        }
        {
          data.cv && (
            <a
              href={data.cv}
              class="border border-line px-6 py-2.5 text-sm font-medium text-navy-700 transition-colors hover:border-navy-900"
            >
              {t('profile.downloadCv')}
            </a>
          )
        }
      </div>
    </div>

    <PortraitCutout
      photo={data.photo}
      alt={data.name[lang]}
      class="mx-auto max-w-lg"
      backdropIndex={data.order}
      waveMask
    />
  </div>
</section>

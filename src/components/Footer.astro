---
import { Image } from 'astro:assets';
import logoInverse from '../assets/brand/logo-inverse.png';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  contactEmail: string;
  socials: { linkedin?: string; facebook?: string; twitter?: string };
}

const { lang, contactEmail, socials } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-navy-700 bg-navy-900 text-paper">
  <div class="container-page flex flex-col gap-10 py-16 md:flex-row md:justify-between">
    <div class="max-w-sm">
      <Image src={logoInverse} alt="NavaLab" class="h-9 w-auto" />
      <p class="mt-4 text-sm text-navy-300">{t('site.tagline')}</p>
    </div>

    <div class="grid grid-cols-2 gap-10 text-sm sm:grid-cols-3">
      <div>
        <p class="mb-3 font-medium text-navy-300">{t('nav.team')}</p>
        <a href={localizePath('/#team', lang)} class="block text-paper hover:text-accent">
          {t('team.heading')}
        </a>
      </div>
      <div>
        <p class="mb-3 font-medium text-navy-300">{t('nav.contact')}</p>
        <a href={`mailto:${contactEmail}`} class="block text-paper hover:text-accent">
          {contactEmail}
        </a>
      </div>
      <div>
        <p class="mb-3 font-medium text-navy-300">Social</p>
        <ul class="flex flex-col gap-2">
          {
            socials.linkedin && (
              <li>
                <a href={socials.linkedin} class="text-paper hover:text-accent">LinkedIn</a>
              </li>
            )
          }
          {
            socials.facebook && (
              <li>
                <a href={socials.facebook} class="text-paper hover:text-accent">Facebook</a>
              </li>
            )
          }
          {
            socials.twitter && (
              <li>
                <a href={socials.twitter} class="text-paper hover:text-accent">X / Twitter</a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-navy-700">
    <p class="container-page py-6 text-xs text-navy-300">
      &copy; {year} NavaLab — {t('footer.rights')}
    </p>
  </div>
</footer>

---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  lang={lang}
  cleanPath="/projects"
  title={t('projects.heading')}
  description={t('projects.heading')}
>
  <section class="py-20">
    <div class="container-page">
      <p class="eyebrow mb-4">{t('research.eyebrow')}</p>
      <h1 class="max-w-xl text-4xl font-bold text-navy-900">{t('projects.heading')}</h1>

      <div class="mt-16 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <a href={localizePath(`/projects/${project.id}`, lang)} class="group block">
              <div class="aspect-[3/2] overflow-hidden bg-navy-700">
                <Image
                  src={project.data.cover}
                  alt={project.data.title[lang]}
                  width={480}
                  height={320}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <p class="mt-4 text-xs font-medium uppercase tracking-wide text-navy-300">
                {t(project.data.status === 'ongoing' ? 'projects.status.ongoing' : 'projects.status.completed')}
                {' · '}
                {project.data.year}
              </p>
              <h2 class="mt-1 font-display text-lg font-bold text-navy-900 group-hover:text-accent">
                {project.data.title[lang]}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{project.data.summary[lang]}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
